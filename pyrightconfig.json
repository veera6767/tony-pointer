{
  "pythonVersion": "3.12",
  "venvPath": ".",
  "venv": ".venv",
  "extraPaths": [
    "pointer_v",
    "."
  ],
  "include": [
    "pointer_v",
    "scripts",
    "tests"
  ],
  "exclude": [
    "**/node_modules",
    "**/__pycache__",
    "**/dist",
    "**/build",
    "**/pointer_v/dist",
    "**/pointer_v/build",
    "**/pointer_v/_old_ui",
    "**/pointer_v/_backups",
    "**/.pytest_cache",
    ".venv"
  ],
  "typeCheckingMode": "basic",
  "reportMissingImports": true,
  "reportMissingTypeStubs": false
}
